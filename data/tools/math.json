{
  "domain": "math",
  "tools": [
    {"name": "add", "description": "Add two numbers",
     "args": [{"name": "a", "type": "float"}, {"name": "b", "type": "float"}],
     "templates": ["add {a} and {b}", "what's {a} plus {b}", "{a} + {b}", "what is the sum of {a} and {b}",
                   "{a} plus {b}", "what do {a} and {b} add up to", "total of {a} and {b}", "increase {a} by {b}", "how much is {a} and {b} together", "{a} and {b} combined", "put {a} and {b} together"]},
    {"name": "subtract", "description": "Subtract one number from another",
     "args": [{"name": "a", "type": "float"}, {"name": "b", "type": "float"}],
     "templates": ["subtract {b} from {a}", "what's {a} minus {b}", "{a} take away {b}",
                   "take {b} away from {a}", "{a} less {b}", "{a} minus {b}", "what's the difference between {a} and {b}", "how much is left if I take {b} from {a}", "reduce {a} by {b}", "{b} off {a}"]},
    {"name": "multiply", "description": "Multiply two numbers",
     "args": [{"name": "a", "type": "float"}, {"name": "b", "type": "float"}],
     "templates": ["multiply {a} by {b}", "what's {a} times {b}", "{a} multiplied by {b}",
                   "{a} x {b}", "{a} * {b}", "product of {a} and {b}", "{a} lots of {b}", "{b} groups of {a}", "how much is {a} times {b}", "{a} by {b}"]},
    {"name": "divide", "description": "Divide one number by another",
     "args": [{"name": "a", "type": "float"}, {"name": "b", "type": "float"}],
     "templates": ["divide {a} by {b}", "what's {a} divided by {b}", "{a} over {b}",
                   "{a} / {b}", "split {a} between {b} people", "split {a} {b} ways", "how many times does {b} go into {a}", "share {a} among {b}", "{a} into {b} equal parts", "{a} shared by {b}"]},
    {"name": "convert_units", "description": "Convert a value between units",
     "args": [
       {"name": "value", "type": "float"},
       {"name": "from_unit", "type": "enum", "options": ["km", "miles", "kg", "pounds", "celsius", "fahrenheit"]},
       {"name": "to_unit", "type": "enum", "options": ["km", "miles", "kg", "pounds", "celsius", "fahrenheit"]}
     ],
     "templates": ["convert[ {value}] {from_unit}[ to {to_unit}]", "how many {to_unit} is {value} {from_unit}", "{value} {from_unit} in {to_unit}"]}
  ]
}
